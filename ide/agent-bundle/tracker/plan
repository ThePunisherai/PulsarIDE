#!/usr/bin/env bash
# PlanIDE CLI wrapper. Keeps your current working directory (so relative paths
# work) while making the bundled `planide` package importable.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${DIR}${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m planide "$@"
