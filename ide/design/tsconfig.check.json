        "./stubs/sonner.ts"
      ],
      "react": [
        "./.work/node_modules/@types/react"
      ],
      "react-dom": [
        "./.work/node_modules/@types/react-dom"
      ],
      "clsx": [
        "./.work/node_modules/clsx"
      ],
      "tailwind-merge": [
        "./.work/node_modules/tailwind-merge"
      ],
      "class-variance-authority": [
        "./.work/node_modules/class-variance-authority"
      ],
      "radix-ui": [
        "./.work/node_modules/radix-ui"
      ],
