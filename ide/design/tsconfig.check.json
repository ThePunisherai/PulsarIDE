    },
    "typeRoots": [
      "./.work/node_modules/@types"
    ]
  },
  "include": [
    "../overlay/src/renderer/src/components/planide/PlanIdeView.tsx",
    "../overlay/src/renderer/src/components/planide/PlanIdeMark.tsx",
    "../overlay/src/renderer/src/components/right-sidebar/PlanIdePanel.tsx",
